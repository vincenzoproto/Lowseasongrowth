<div class="lsg">
<header class="lsg-header"><div class="lsg-shell lsg-header-in">
  <a class="lsg-brand" href="{{ routes.root_url }}"><strong>Low Season Growth</strong><span>{% if is_it %}Strategia per hospitality indipendente{% else %}Independent hospitality growth{% endif %}</span></a>
  <nav class="lsg-nav"><a href="#audit">Revenue Audit</a><a href="#deliverables">{% if is_it %}Cosa ricevi{% else %}What you get{% endif %}</a><a href="#process">{% if is_it %}Come funziona{% else %}How it works{% endif %}</a><a href="#support">{% if is_it %}Supporto{% else %}More support{% endif %}</a><a href="#faq">FAQ</a></nav>
  <div class="lsg-actions"><div class="lsg-lang"><a href="/" class="{% unless is_it %}active{% endunless %}">EN</a><a href="/it" class="{% if is_it %}active{% endif %}">IT</a></div><a class="lsg-btn lsg-btn-primary" href="{{ audit_url | strip }}">{% if is_it %}Inizia dall'Audit{% else %}Start with the Audit{% endif %}</a></div>
  <details class="lsg-menu"><summary>MENU</summary><nav><a href="#audit">Revenue Audit</a><a href="#deliverables">{% if is_it %}Cosa ricevi{% else %}What you get{% endif %}</a><a href="#process">{% if is_it %}Come funziona{% else %}How it works{% endif %}</a><a href="#support">{% if is_it %}Supporto{% else %}More support{% endif %}</a><a href="#faq">FAQ</a><a href="{{ audit_url | strip }}">{% if is_it %}Inizia dall'Audit{% else %}Start with the Audit{% endif %}</a></nav></details>
</div></header>

<main>
<section class="lsg-hero"><div class="lsg-shell lsg-hero-grid"><div>
  <p class="lsg-kicker">{% if is_it %}Per B&B, guest house e piccole strutture{% else %}For B&Bs, guest houses & small properties{% endif %}</p>
  <h1>{% if is_it %}Trova il potenziale che stai lasciando nei mesi più tranquilli.{% else %}Find the revenue potential hiding in your quiet months.{% endif %}</h1>
  <p class="lsg-lead">{% if is_it %}Partiamo da una diagnosi concreta della tua struttura: offerta, posizionamento, percorso di prenotazione diretta e opportunità nei periodi deboli. Niente retainer, niente playbook generici.{% else %}We start with a property-specific diagnosis: offer, positioning, direct-booking journey and opportunities in weak-demand periods. No retainer. No generic playbook.{% endif %}</p>
  <div class="lsg-chips"><span class="lsg-chip">Revenue Audit · {% if audit != blank %}{{ audit.price | money }}{% else %}€249{% endif %}</span><span class="lsg-chip">{% if is_it %}Consegna entro 5 giorni lavorativi{% else %}Delivered within 5 business days{% endif %}</span><span class="lsg-chip">{% if is_it %}Acquisto una tantum{% else %}One-time purchase{% endif %}</span></div>
  <div class="lsg-hero-ctas"><a class="lsg-btn lsg-btn-primary" href="{{ audit_url | strip }}">{% if is_it %}Ottieni il Revenue Audit{% else %}Get the Revenue Audit{% endif %}</a><a class="lsg-btn lsg-btn-ghost" href="#sample">{% if is_it %}Guarda un esempio{% else %}See a sample{% endif %}</a></div>
  <p class="lsg-credit">{% if is_it %}Se passi a Booking Sprint o Growth Partner entro 14 giorni dalla consegna, quanto pagato per l'Audit viene accreditato sul servizio successivo, secondo le condizioni applicabili.{% else %}Upgrade to Booking Sprint or Growth Partner within 14 days of delivery and the amount paid for the Audit is credited toward the next service, under the applicable terms.{% endif %}</p>
</div><div class="lsg-preview" aria-label="Illustrative Revenue Audit sample">
  <span class="lsg-sample-tag">{% if is_it %}Esempio illustrativo{% else %}Illustrative sample{% endif %}</span>
  <div class="lsg-preview-head"><h3>Low Season<br>Revenue Audit</h3><span>{% if is_it %}Struttura campione<br>non cliente reale{% else %}Sample property<br>not a real client{% endif %}</span></div>
  <div class="lsg-preview-row"><span class="lsg-num">1</span><div><strong>{% if is_it %}Posizionamento{% else %}Positioning{% endif %}</strong><p>{% if is_it %}Chiarezza dell'offerta e motivo per prenotare{% else %}Offer clarity and reason to book{% endif %}</p></div><span class="lsg-state">Review</span></div>
  <div class="lsg-preview-row"><span class="lsg-num">2</span><div><strong>{% if is_it %}Date deboli{% else %}Quiet dates{% endif %}</strong><p>{% if is_it %}Finestre di domanda da attivare{% else %}Demand windows to activate{% endif %}</p></div><span class="lsg-state">Map</span></div>
  <div class="lsg-preview-row"><span class="lsg-num">3</span><div><strong>{% if is_it %}Prenotazione diretta{% else %}Direct booking{% endif %}</strong><p>{% if is_it %}Attriti, messaggi e call to action{% else %}Friction, messaging and calls to action{% endif %}</p></div><span class="lsg-state">Fix</span></div>
  <div class="lsg-preview-row"><span class="lsg-num">4</span><div><strong>{% if is_it %}Priorità{% else %}Priorities{% endif %}</strong><p>{% if is_it %}Azioni ordinate per impatto e sforzo{% else %}Actions ranked by impact and effort{% endif %}</p></div><span class="lsg-state">Plan</span></div>
  <div class="lsg-preview-foot"><strong>{% if is_it %}Obiettivo:{% else %}Purpose:{% endif %}</strong> {% if is_it %}darti un piano breve e utilizzabile, non un report da archiviare.{% else %}give you a short, usable plan — not a report that sits in a folder.{% endif %}</div>
</div></div></section>

<section class="lsg-trust"><div class="lsg-shell lsg-trust-grid">
  <div class="lsg-trust-item"><strong>{% if is_it %}Hospitality indipendente{% else %}Independent hospitality{% endif %}</strong><span>{% if is_it %}Pensato per strutture snelle{% else %}Built for lean properties{% endif %}</span></div>
  <div class="lsg-trust-item"><strong>{% if is_it %}Analisi specifica{% else %}Property-specific strategy{% endif %}</strong><span>{% if is_it %}Non template preconfezionati{% else %}Not a generic template{% endif %}</span></div>
  <div class="lsg-trust-item"><strong>{% if is_it %}Nessun contratto lungo{% else %}No long-term contract{% endif %}</strong><span>{% if is_it %}Parti con un singolo Audit{% else %}Start with one Audit{% endif %}</span></div>
  <div class="lsg-trust-item"><strong>EN / IT</strong><span>{% if is_it %}Servizio in italiano o inglese{% else %}Service in English or Italian{% endif %}</span></div>
</div></section>

<section id="deliverables" class="lsg-section lsg-paper"><div class="lsg-shell"><div class="lsg-section-head"><div><p class="lsg-kicker">{% if is_it %}Cosa ricevi{% else %}What you get{% endif %}</p><h2>{% if is_it %}Quattro blocchi. Una priorità chiara.{% else %}Four workstreams. One clear priority list.{% endif %}</h2></div><p class="lsg-lead">{% if is_it %}L'Audit è costruito per aiutarti a decidere cosa cambiare prima, dove concentrare tempo e budget e quale proposta portare sul mercato nei periodi più deboli.{% else %}The Audit is designed to help you decide what to change first, where to focus time and budget, and which offer deserves attention in weaker periods.{% endif %}</p></div>
<div class="lsg-grid4">
  <article class="lsg-card"><span class="icon">01</span><h3>{% if is_it %}Diagnosi del posizionamento{% else %}Positioning diagnosis{% endif %}</h3><p>{% if is_it %}Valutiamo promessa, differenziazione e chiarezza dell'offerta vista da un potenziale ospite.{% else %}We review promise, differentiation and offer clarity from a potential guest's point of view.{% endif %}</p></article>
  <article class="lsg-card"><span class="icon">02</span><h3>{% if is_it %}Opportunità low season{% else %}Low-season opportunities{% endif %}</h3><p>{% if is_it %}Individuiamo periodi, segmenti e motivi di viaggio che possono diventare un'offerta più concreta.{% else %}We identify periods, segments and travel reasons that can become a clearer commercial offer.{% endif %}</p></article>
  <article class="lsg-card"><span class="icon">03</span><h3>{% if is_it %}Percorso direct booking{% else %}Direct-booking review{% endif %}</h3><p>{% if is_it %}Cerchiamo attriti tra messaggio, sito, call to action e passaggio verso la prenotazione.{% else %}We look for friction between messaging, website calls to action and the path to booking.{% endif %}</p></article>
  <article class="lsg-card"><span class="icon">04</span><h3>{% if is_it %}Piano prioritario{% else %}Prioritised action plan{% endif %}</h3><p>{% if is_it %}Ricevi azioni ordinate per impatto, urgenza e sforzo, così sai da dove iniziare.{% else %}You receive actions ranked by impact, urgency and effort so you know where to start.{% endif %}</p></article>
</div></div></section>

<section id="audit" class="lsg-section lsg-audit"><div class="lsg-shell lsg-audit-grid"><div>
  <p class="lsg-kicker">{% if is_it %}Il punto di ingresso{% else %}The entry offer{% endif %}</p><h2>{% if is_it %}Revenue Audit: prima capiamo, poi investiamo.{% else %}Revenue Audit: diagnose first, invest second.{% endif %}</h2>
  <p class="lsg-lead">{% if is_it %}Una revisione personalizzata della tua struttura per trasformare problemi vaghi di bassa stagione in priorità commerciali concrete.{% else %}A personalised review of your property that turns vague low-season problems into concrete commercial priorities.{% endif %}</p>
  <div class="lsg-price">{% if audit != blank %}{{ audit.price | money }}{% else %}€249{% endif %}</div><div class="lsg-price-note">{% if is_it %}pagamento una tantum · consegna entro 5 giorni lavorativi dopo aver ricevuto gli input necessari{% else %}one-time payment · delivered within 5 business days after we receive the required inputs{% endif %}</div>
  <a class="lsg-btn" href="{{ audit_url | strip }}">{% if is_it %}Acquista il Revenue Audit{% else %}Purchase the Revenue Audit{% endif %}</a>
</div><div>
  <div class="lsg-list"><div><strong>{% if is_it %}Adatto se…{% else %}A good fit if…{% endif %}</strong><span>{% if is_it %}hai mesi o settimane deboli e vuoi una direzione commerciale più chiara prima di spendere di più in marketing.{% else %}you have weak months or weeks and want clearer commercial direction before spending more on marketing.{% endif %}</span></div><div><strong>{% if is_it %}Ci servono…{% else %}We need…{% endif %}</strong><span>{% if is_it %}sito o listing, contesto della struttura, periodi più deboli, eventuali dati disponibili e obiettivi principali.{% else %}your website or listing, property context, weaker periods, any available data and your main objectives.{% endif %}</span></div><div><strong>{% if is_it %}Ricevi…{% else %}You receive…{% endif %}</strong><span>{% if is_it %}analisi, opportunità, priorità e prossimi passi in un documento utilizzabile dal proprietario o dal team.{% else %}analysis, opportunities, priorities and next steps in a document the owner or team can actually use.{% endif %}</span></div></div>
  <div class="lsg-honest"><strong>{% if is_it %}Cosa non promettiamo:{% else %}What we do not promise:{% endif %}</strong> {% if is_it %}nessun numero garantito di prenotazioni o ricavi. Il valore dell'Audit è una diagnosi migliore e un piano più chiaro da implementare e misurare.{% else %}we do not guarantee a specific number of bookings or revenue. The value of the Audit is better diagnosis and a clearer plan you can implement and measure.{% endif %}</div>
</div></div></section>

<section id="sample" class="lsg-section"><div class="lsg-shell"><div class="lsg-section-head"><div><p class="lsg-kicker">{% if is_it %}Esempio di ragionamento{% else %}Sample thinking{% endif %}</p><h2>{% if is_it %}Non solo “fai più marketing”.{% else %}More useful than “do more marketing.”{% endif %}</h2></div><p class="lsg-lead">{% if is_it %}Ecco il tipo di passaggio da osservazione a decisione che cerchiamo. Gli esempi sotto sono illustrativi e non derivano da un cliente reale.{% else %}Here is the type of observation-to-decision thinking we look for. The examples below are illustrative and are not based on a real client.{% endif %}</p></div>
<p class="lsg-sample-note">{% if is_it %}Esempio illustrativo — non rappresenta risultati reali o garantiti.{% else %}Illustrative example — does not represent real or guaranteed results.{% endif %}</p>
<div class="lsg-insights">
  <article class="lsg-insight"><small>{% if is_it %}Osservazione{% else %}Observation{% endif %}</small><h3>{% if is_it %}L'offerta parla della camera, non del motivo per partire.{% else %}The offer sells the room, not the reason to travel.{% endif %}</h3><p>{% if is_it %}Nei periodi deboli la disponibilità da sola raramente crea domanda. Serve un motivo più specifico per scegliere quelle date.{% else %}In weaker periods, availability alone rarely creates demand. The guest needs a clearer reason to choose those dates.{% endif %}</p><div class="lsg-action">{% if is_it %}Prima azione: definire una proposta legata a un segmento e a un periodo preciso.{% else %}First action: define one offer tied to a specific segment and period.{% endif %}</div></article>
  <article class="lsg-insight"><small>{% if is_it %}Attrito{% else %}Friction{% endif %}</small><h3>{% if is_it %}Il vantaggio del direct booking non è visibile.{% else %}The direct-booking advantage is invisible.{% endif %}</h3><p>{% if is_it %}Se il sito non spiega perché prenotare direttamente, l'ospite non ha una ragione evidente per uscire dalle OTA.{% else %}If the site does not explain why booking direct is better, the guest has little reason to leave the OTA path.{% endif %}</p><div class="lsg-action">{% if is_it %}Prima azione: rendere il beneficio direct booking specifico e vicino alla CTA.{% else %}First action: make the direct-booking benefit specific and place it near the CTA.{% endif %}</div></article>
  <article class="lsg-insight"><small>{% if is_it %}Priorità{% else %}Priority{% endif %}</small><h3>{% if is_it %}Troppe iniziative, nessuna campagna completa.{% else %}Too many tactics, no complete campaign.{% endif %}</h3><p>{% if is_it %}Post, sconti e newsletter scollegati consumano tempo senza costruire una proposta coerente da misurare.{% else %}Disconnected posts, discounts and newsletters consume time without creating a coherent offer to measure.{% endif %}</p><div class="lsg-action">{% if is_it %}Prima azione: scegliere un solo periodo e portare una proposta completa fino al mercato.{% else %}First action: choose one period and take one complete proposition to market.{% endif %}</div></article>
</div></div></section>

<section id="process" class="lsg-section lsg-paper"><div class="lsg-shell"><div class="lsg-section-head"><div><p class="lsg-kicker">{% if is_it %}Come funziona{% else %}How it works{% endif %}</p><h2>{% if is_it %}Dal checkout a un piano utilizzabile.{% else %}From checkout to a usable plan.{% endif %}</h2></div><p class="lsg-lead">{% if is_it %}Un processo semplice per non trasformare un Audit da €249 in settimane di riunioni.{% else %}A simple process so a €249 Audit does not become weeks of meetings.{% endif %}</p></div>
<div class="lsg-process"><div class="lsg-step"><b>1</b><h3>{% if is_it %}Acquisto{% else %}Checkout{% endif %}</h3><p>{% if is_it %}Acquisti il Revenue Audit tramite il checkout Shopify.{% else %}Purchase the Revenue Audit through Shopify checkout.{% endif %}</p></div><div class="lsg-step"><b>2</b><h3>{% if is_it %}Questionario{% else %}Questionnaire{% endif %}</h3><p>{% if is_it %}Raccogliamo dati essenziali, date deboli, obiettivi e link.{% else %}We collect essential context, weak dates, objectives and links.{% endif %}</p></div><div class="lsg-step"><b>3</b><h3>{% if is_it %}Analisi{% else %}Analysis{% endif %}</h3><p>{% if is_it %}Valutiamo posizionamento, offerta, percorso direct booking e priorità.{% else %}We review positioning, offer, direct-booking journey and priorities.{% endif %}</p></div><div class="lsg-step"><b>4</b><h3>{% if is_it %}Consegna{% else %}Delivery{% endif %}</h3><p>{% if is_it %}Ricevi l'Audit entro 5 giorni lavorativi dopo gli input necessari.{% else %}Receive the Audit within 5 business days after required inputs.{% endif %}</p></div></div>
</div></section>

<section id="support" class="lsg-section"><div class="lsg-shell"><div class="lsg-section-head"><div><p class="lsg-kicker">{% if is_it %}Se vuoi implementare con noi{% else %}If you want implementation support{% endif %}</p><h2>{% if is_it %}L'Audit viene prima. Gli upgrade dopo.{% else %}The Audit comes first. Upgrades come second.{% endif %}</h2></div><p class="lsg-lead">{% if is_it %}Non devi scegliere il servizio più costoso senza contesto. Se il fit è giusto, puoi passare a un livello operativo dopo aver visto le priorità.{% else %}You do not need to choose the most expensive service without context. If the fit is right, you can move into implementation after seeing the priorities.{% endif %}</p></div>
<div class="lsg-upgrades">
  <article class="lsg-upgrade"><div class="lsg-upgrade-top"><h3>Booking Sprint</h3><div class="lsg-upgrade-price">{% if sprint != blank %}{{ sprint.price | money }}{% else %}€479{% endif %}</div></div><p>{% if is_it %}Per trasformare una priorità dell'Audit in un'offerta concreta e un piano di attivazione di 30 giorni.{% else %}Turn one Audit priority into a concrete offer and a 30-day activation plan.{% endif %}</p><ul><li>{% if is_it %}Offerta + messaggi principali{% else %}Offer + core messaging{% endif %}</li><li>{% if is_it %}Piano di attivazione 30 giorni{% else %}30-day activation plan{% endif %}</li><li>{% if is_it %}1 call di lavoro / revisione{% else %}1 working / review call{% endif %}</li></ul><a class="lsg-btn lsg-btn-ghost" href="{{ sprint_url | strip }}">{% if is_it %}Vedi Booking Sprint{% else %}View Booking Sprint{% endif %}</a></article>
  <article class="lsg-upgrade"><div class="lsg-upgrade-top"><h3>Growth Partner</h3><div class="lsg-upgrade-price">{% if partner != blank %}{{ partner.price | money }}{% else %}€990{% endif %}</div></div><p>{% if is_it %}Per strutture che vogliono più supporto nella costruzione della campagna e nell'implementazione per 30 giorni.{% else %}For properties that want deeper support building the campaign and guiding implementation for 30 days.{% endif %}</p><ul><li>{% if is_it %}Roadmap commerciale e campagna{% else %}Commercial roadmap + campaign{% endif %}</li><li>{% if is_it %}Supporto implementazione 30 giorni{% else %}30-day implementation support{% endif %}</li><li>{% if is_it %}2 call di lavoro / revisione{% else %}2 working / review calls{% endif %}</li></ul><a class="lsg-btn lsg-btn-ghost" href="{{ partner_url | strip }}">{% if is_it %}Vedi Growth Partner{% else %}View Growth Partner{% endif %}</a></article>
</div></div></section>

<section class="lsg-section lsg-paper"><div class="lsg-shell lsg-founder"><div class="lsg-founder-photo">{% if section.settings.founder_image != blank %}{{ section.settings.founder_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Vincenzo Proto - Low Season Growth' }}{% else %}<span class="lsg-monogram">VP</span>{% endif %}</div><div class="lsg-founder-copy"><p class="lsg-kicker">{% if is_it %}Dietro Low Season Growth{% else %}Behind Low Season Growth{% endif %}</p><h2>{% if is_it %}Un approccio commerciale, non un'altra dashboard.{% else %}A commercial approach, not another dashboard.{% endif %}</h2><p class="lsg-lead">{% if is_it %}Low Season Growth è guidata da Vincenzo Proto e nasce per aiutare piccole strutture ricettive a prendere decisioni più chiare nei periodi di domanda debole: cosa vendere, a chi, come presentarlo e cosa correggere prima di spendere altro budget.{% else %}Low Season Growth is led by Vincenzo Proto and exists to help small hospitality properties make clearer decisions in weak-demand periods: what to sell, who to sell it to, how to present it and what to fix before spending more budget.{% endif %}</p><div class="lsg-founder-sign">Vincenzo Proto · Founder, Low Season Growth</div></div></div></section>

<section id="faq" class="lsg-section"><div class="lsg-shell lsg-faq"><div><p class="lsg-kicker">FAQ</p><h2>{% if is_it %}Prima di acquistare.{% else %}Before you buy.{% endif %}</h2></div><div class="lsg-faq-list">
<details><summary>{% if is_it %}Per quali strutture è pensato il Revenue Audit?{% else %}Which properties is the Revenue Audit designed for?{% endif %}</summary><p>{% if is_it %}Soprattutto B&B, guest house, vacation rental e piccole strutture indipendenti con periodi di domanda debole e team commerciali snelli.{% else %}Primarily B&Bs, guest houses, vacation rentals and small independent properties with weak-demand periods and lean commercial teams.{% endif %}</p></details>
<details><summary>{% if is_it %}Quanto tempo richiede alla struttura?{% else %}How much time does the property need to invest?{% endif %}</summary><p>{% if is_it %}Principalmente il questionario iniziale e la condivisione dei link o dati rilevanti. Non è prevista una call obbligatoria per completare l'Audit.{% else %}Mostly the initial questionnaire and sharing relevant links or data. A call is not mandatory to complete the Audit.{% endif %}</p></details>
<details><summary>{% if is_it %}Quando viene consegnato?{% else %}When is it delivered?{% endif %}</summary><p>{% if is_it %}Entro 5 giorni lavorativi da quando abbiamo le informazioni necessarie per iniziare l'analisi.{% else %}Within 5 business days once we have the information required to begin the analysis.{% endif %}</p></details>
<details><summary>{% if is_it %}Garantisce più prenotazioni?{% else %}Does it guarantee more bookings?{% endif %}</summary><p>{% if is_it %}No. Nessun servizio serio può garantire un numero specifico di prenotazioni. L'Audit serve a identificare opportunità, attriti e priorità da implementare e misurare.{% else %}No. No serious service can guarantee a specific booking number. The Audit identifies opportunities, friction and priorities you can implement and measure.{% endif %}</p></details>
<details><summary>{% if is_it %}Come funziona il credito dell'Audit?{% else %}How does the Audit upgrade credit work?{% endif %}</summary><p>{% if is_it %}Se acquisti Booking Sprint o Growth Partner entro 14 giorni dalla consegna dell'Audit, l'importo pagato per l'Audit viene accreditato sul servizio successivo secondo le condizioni applicabili.{% else %}If you purchase Booking Sprint or Growth Partner within 14 days of Audit delivery, the amount paid for the Audit is credited toward the next service under the applicable terms.{% endif %}</p></details>
<details><summary>{% if is_it %}In quali lingue lavorate?{% else %}Which languages do you support?{% endif %}</summary><p>{% if is_it %}Il servizio è disponibile in italiano e inglese.{% else %}The service is available in English and Italian.{% endif %}</p></details>
</div></div></section>

<section class="lsg-final"><div class="lsg-shell"><p class="lsg-kicker">{% if is_it %}Un primo passo semplice{% else %}A simple first step{% endif %}</p><h2>{% if is_it %}Prima di aggiungere altre campagne, capisci cosa vale davvero la pena cambiare.{% else %}Before adding more campaigns, identify what is actually worth changing.{% endif %}</h2><p>{% if is_it %}Inizia con un Revenue Audit personalizzato. Una tantum, senza contratto lungo, con consegna entro 5 giorni lavorativi dopo gli input necessari.{% else %}Start with a personalised Revenue Audit. One-time purchase, no long contract, delivered within 5 business days after required inputs.{% endif %}</p><a class="lsg-btn lsg-btn-primary" href="{{ audit_url | strip }}">{% if is_it %}Ottieni il Revenue Audit — {% if audit != blank %}{{ audit.price | money }}{% else %}€249{% endif %}{% else %}Get the Revenue Audit — {% if audit != blank %}{{ audit.price | money }}{% else %}€249{% endif %}{% endif %}</a></div></section>
</main>

<footer class="lsg-footer"><div class="lsg-shell"><div class="lsg-footer-in"><div class="lsg-footer-brand"><strong>Low Season Growth</strong><p>{% if is_it %}Strategia pratica per i periodi di domanda debole delle strutture ricettive indipendenti.{% else %}Practical strategy for weak-demand periods in independent hospitality.{% endif %}</p></div><nav class="lsg-footer-col"><strong>{% if is_it %}Servizi{% else %}Services{% endif %}</strong><a href="{{ audit_url | strip }}">Revenue Audit</a><a href="{{ sprint_url | strip }}">Booking Sprint</a><a href="{{ partner_url | strip }}">Growth Partner</a></nav><nav class="lsg-footer-col"><strong>{% if is_it %}Azienda{% else %}Company{% endif %}</strong><a href="{{ routes.root_url }}pages/about-low-season-growth">{% if is_it %}Chi siamo{% else %}About{% endif %}</a><a href="{{ routes.root_url }}pages/sales-partner">{% if is_it %}Diventa Sales Partner{% else %}Become a Sales Partner{% endif %}</a></nav><nav class="lsg-footer-col"><strong>{% if is_it %}Info{% else %}Info{% endif %}</strong><a href="#faq">FAQ</a>{% if shop.privacy_policy.url != blank %}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{% endif %}{% if shop.refund_policy.url != blank %}<a href="{{ shop.refund_policy.url }}">{% if is_it %}Rimborsi{% else %}Refunds{% endif %}</a>{% endif %}</nav></div><div class="lsg-bottom"><span>© {{ 'now' | date: '%Y' }} Low Season Growth</span><div class="lsg-bottom-links">{% if shop.terms_of_service.url != blank %}<a href="{{ shop.terms_of_service.url }}">{% if is_it %}Termini e condizioni{% else %}Terms & Conditions{% endif %}</a>{% endif %}{% if shop.privacy_policy.url != blank %}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{% endif %}</div></div></div></footer>

<div class="lsg-mobile-cta"><span>Revenue Audit · {% if audit != blank %}{{ audit.price | money }}{% else %}€249{% endif %}<small>{% if is_it %}Consegna entro 5 giorni lavorativi{% else %}Delivered within 5 business days{% endif %}</small></span><a href="{{ audit_url | strip }}">{% if is_it %}Inizia{% else %}Start{% endif %} →</a></div>
</div>

