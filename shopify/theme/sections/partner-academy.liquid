<section class="lsg-academy-hub" id="lsg-academy-hub">
  {% if customer == blank %}
    <div class="lsg-academy-gate"><h1 data-it="LSG Academy" data-en="LSG Academy">LSG Academy</h1><p data-it="Accedi con il tuo account partner per iniziare la formazione." data-en="Sign in with your partner account to start training.">Accedi con il tuo account partner per iniziare la formazione.</p><a href="{{ routes.account_login_url }}" class="lsg-a-btn" data-it="Accedi" data-en="Sign in">Accedi</a></div>
  {% elsif customer.tags contains 'lsg-partner' %}
    {% assign academy_progress = customer.metafields.partner.academy_progress.value | default: 0 %}
    <div class="lsg-a-shell">
      <header class="lsg-a-head"><div><p class="lsg-a-eyebrow">LSG Academy</p><h1 data-it="Impara a vendere LowSeasonGrowth" data-en="Learn how to sell LowSeasonGrowth">Impara a vendere LowSeasonGrowth</h1><p data-it="Percorso pratico per prospecting, outreach, call e closing." data-en="A practical path covering prospecting, outreach, calls and closing.">Percorso pratico per prospecting, outreach, call e closing.</p></div><div class="lsg-a-lang"><button data-lang="it">IT</button><button data-lang="en">EN</button></div></header>
      <div class="lsg-a-progress"><div><span data-it="Progresso" data-en="Progress">Progresso</span><strong>{{ academy_progress }}%</strong></div><div class="lsg-a-bar"><i style="width:{{ academy_progress }}%"></i></div></div>
      <div class="lsg-a-grid">
        <article><b>01</b><h2 data-it="Offerta e posizionamento" data-en="Offer & positioning">Offerta e posizionamento</h2><p data-it="Capisci i pacchetti LSG, il problema che risolvono e come spiegarne il valore senza vendere 'marketing generico'." data-en="Understand LSG packages, the problem they solve, and how to communicate value without selling generic marketing.">Capisci i pacchetti LSG, il problema che risolvono e come spiegarne il valore senza vendere 'marketing generico'.</p><div class="lsg-a-tags"><span>ICP</span><span>Value proposition</span><span>Packages</span></div></article>
        <article><b>02</b><h2 data-it="Prospecting" data-en="Prospecting">Prospecting</h2><p data-it="Come riconoscere B&B e hotel con bisogno reale di domanda in bassa stagione e priorità commerciale alta." data-en="How to identify B&Bs and hotels with real low-season demand problems and high sales priority.">Come riconoscere B&B e hotel con bisogno reale di domanda in bassa stagione e priorità commerciale alta.</p><div class="lsg-a-tags"><span>Signals</span><span>Qualification</span><span>Lead list</span></div></article>
        <article><b>03</b><h2 data-it="Outreach" data-en="Outreach">Outreach</h2><p data-it="Email, DM e WhatsApp brevi, personalizzati e orientati alla conversazione, non al pitch infinito." data-en="Short, personalized email, DM and WhatsApp outreach designed to start a conversation, not deliver an endless pitch.">Email, DM e WhatsApp brevi, personalizzati e orientati alla conversazione, non al pitch infinito.</p><div class="lsg-a-tags"><span>Email</span><span>DM</span><span>WhatsApp</span></div></article>
        <article><b>04</b><h2 data-it="Discovery call" data-en="Discovery call">Discovery call</h2><p data-it="Domande per capire occupazione, stagionalità, canali attuali, priorità e capacità di spesa prima di proporre un pacchetto." data-en="Questions to understand occupancy, seasonality, current channels, priorities and budget before recommending a package.">Domande per capire occupazione, stagionalità, canali attuali, priorità e capacità di spesa prima di proporre un pacchetto.</p><div class="lsg-a-tags"><span>Discovery</span><span>Needs</span><span>Budget</span></div></article>
        <article><b>05</b><h2 data-it="Obiezioni e closing" data-en="Objections & closing">Obiezioni e closing</h2><p data-it="Gestisci 'costa troppo', 'ci penso', 'abbiamo già qualcuno' e chiudi con un prossimo passo concreto." data-en="Handle 'too expensive', 'I need to think', and 'we already have someone', then close with a concrete next step.">Gestisci 'costa troppo', 'ci penso', 'abbiamo già qualcuno' e chiudi con un prossimo passo concreto.</p><div class="lsg-a-tags"><span>Objections</span><span>Closing</span><span>Follow-up</span></div></article>
        <article><b>06</b><h2 data-it="Regole commissioni" data-en="Commission rules">Regole commissioni</h2><p data-it="Come funziona attribuzione, hold di 30 giorni, commissione maturata, payout e casi di rimborso o chargeback." data-en="How attribution, the 30-day hold, earned commissions, payouts, refunds and chargebacks work.">Come funziona attribuzione, hold di 30 giorni, commissione maturata, payout e casi di rimborso o chargeback.</p><div class="lsg-a-tags"><span>Attribution</span><span>Payout</span><span>Policy</span></div></article>
      </div>
      <div class="lsg-a-resources"><h2 data-it="Risorse rapide" data-en="Quick resources">Risorse rapide</h2><div><a href="/pages/sales-partner" data-it="Programma partner" data-en="Partner program">Programma partner</a><a href="/collections/low-season-growth-packages" data-it="Pacchetti LSG" data-en="LSG packages">Pacchetti LSG</a><a href="/pages/partner-portal" data-it="Torna alla dashboard" data-en="Back to dashboard">Torna alla dashboard</a></div></div>
    </div>
  {% else %}<div class="lsg-academy-gate"><h1 data-it="Accesso riservato" data-en="Restricted access">Accesso riservato</h1><p data-it="L'Academy è disponibile per i partner approvati." data-en="The Academy is available to approved partners.">L'Academy è disponibile per i partner approvati.</p></div>{% endif %}
</section>
<style>.lsg-academy-hub{--ink:#17221d;--muted:#68726c;--accent:#1f6f50;--bg:#f6f5f1;--line:#e1e4e0;background:var(--bg);color:var(--ink);padding:52px 20px}.lsg-a-shell{max-width:1120px;margin:auto}.lsg-a-head{display:flex;justify-content:space-between;gap:30px;align-items:flex-start;margin-bottom:24px}.lsg-a-head h1{font-size:clamp(34px,5vw,58px);max-width:760px;margin:5px 0 12px}.lsg-a-head p{color:var(--muted);max-width:680px}.lsg-a-eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:var(--accent)!important;font-weight:700}.lsg-a-lang{display:flex;background:white;border:1px solid var(--line);border-radius:999px;padding:4px}.lsg-a-lang button{border:0;background:transparent;padding:8px 11px;border-radius:999px}.lsg-a-lang button.active{background:var(--ink);color:white}.lsg-a-progress{background:white;border:1px solid var(--line);border-radius:18px;padding:18px;margin-bottom:18px}.lsg-a-progress>div:first-child{display:flex;justify-content:space-between}.lsg-a-bar{height:9px;background:#e9ece9;border-radius:99px;margin-top:12px;overflow:hidden}.lsg-a-bar i{height:100%;display:block;background:var(--accent)}.lsg-a-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.lsg-a-grid article{background:white;border:1px solid var(--line);border-radius:20px;padding:22px}.lsg-a-grid article>b{display:inline-grid;place-items:center;width:38px;height:38px;background:#edf4ef;color:var(--accent);border-radius:50%}.lsg-a-grid h2{margin:16px 0 8px}.lsg-a-grid p{color:var(--muted);line-height:1.55}.lsg-a-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:15px}.lsg-a-tags span{font-size:12px;background:#f0f2ef;border-radius:999px;padding:7px 9px}.lsg-a-resources{background:var(--ink);color:white;border-radius:22px;padding:24px;margin-top:18px}.lsg-a-resources>div{display:flex;gap:10px;flex-wrap:wrap}.lsg-a-resources a,.lsg-a-btn{background:white;color:var(--ink);text-decoration:none;border-radius:10px;padding:11px 14px;font-weight:700}.lsg-academy-gate{max-width:650px;text-align:center;margin:70px auto}.lsg-academy-gate p{color:var(--muted);margin-bottom:24px}@media(max-width:760px){.lsg-a-head{flex-direction:column}.lsg-a-grid{grid-template-columns:1fr}}</style>
<script>(function(){var r=document.getElementById('lsg-academy-hub');if(!r)return;function s(l){r.querySelectorAll('[data-it][data-en]').forEach(function(e){e.textContent=e.getAttribute('data-'+l)});r.querySelectorAll('[data-lang]').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-lang')===l)});try{localStorage.setItem('lsg_partner_lang',l)}catch(e){}}r.querySelectorAll('[data-lang]').forEach(function(b){b.addEventListener('click',function(){s(b.getAttribute('data-lang'))})});var l='it';try{l=localStorage.getItem('lsg_partner_lang')||((navigator.language||'').toLowerCase().indexOf('it')===0?'it':'en')}catch(e){}s(l)})();</script>
{% schema %}{"name":"LSG Partner Academy","settings":[],"presets":[{"name":"LSG Partner Academy"}]}{% endschema %}