{% assign audit = all_products['b-b-low-season-opportunity-audit'] %}
{% assign sprint = all_products['b-b-low-season-booking-sprint'] %}
{% assign partner = all_products['b-b-low-season-growth-partner'] %}

<section class="lsg4" aria-label="Low Season Growth">
  <div class="lsg4-hero">
    <div class="lsg4-wrap lsg4-hero-grid">
      <div class="lsg4-hero-copy">
        <p class="lsg4-kicker">LOW-SEASON STRATEGY FOR INDEPENDENT HOSPITALITY</p>
        <h1>Turn quiet months into a reason to book.</h1>
        <p class="lsg4-lead">Property-specific consulting for independent B&amp;Bs and guest houses that want clearer positioning, stronger seasonal offers and more direct-booking opportunities.</p>
        <div class="lsg4-actions">
          <a href="#packages" class="lsg4-btn lsg4-btn-primary">Compare packages</a>
          <a href="#process" class="lsg4-btn lsg4-btn-secondary">How it works</a>
        </div>
        <div class="lsg4-trust" aria-label="Service highlights">
          <span>One-time payment</span>
          <span>Personalized for your property</span>
          <span>English or Italian</span>
        </div>
      </div>
      <figure class="lsg4-hero-media">
        <div class="lsg4-hero-frame">
          <img src="https://cdn.shopify.com/s/files/1/1059/8488/5078/files/low-season-growth-hero.png?v=1788474201" alt="Low Season Growth strategy illustration" width="1672" height="941" fetchpriority="high">
        </div>
        <figcaption>From quieter dates to a clearer commercial plan.</figcaption>
      </figure>
    </div>
  </div>

  <div class="lsg4-proof">
    <div class="lsg4-wrap lsg4-proof-grid">
      <span>Property-specific analysis</span>
      <span>Commercial focus, not generic content</span>
      <span>Clear scope, price and delivery</span>
    </div>
  </div>

  <div class="lsg4-section" id="packages">
    <div class="lsg4-wrap">
      <div class="lsg4-head">
        <p class="lsg4-kicker">PACKAGES</p>
        <h2>Choose the level of support you actually need.</h2>
        <p>Three focused, one-time services. Start with diagnosis, build a complete low-season plan, or add hands-on strategic support.</p>
      </div>

      <div class="lsg4-packages">
        <article class="lsg4-card lsg4-card-audit">
          <div class="lsg4-card-visual">
            {% if audit.featured_image %}
              <img src="{{ audit.featured_image | image_url: width: 1200 }}" alt="Opportunity Audit" loading="lazy" width="1200" height="900">
            {% endif %}
            <span class="lsg4-visual-tag">DIAGNOSE</span>
          </div>
          <div class="lsg4-card-body">
            <div class="lsg4-card-top">
              <h3>Opportunity Audit</h3>
              <p class="lsg4-price">{{ audit.price | money }}</p>
            </div>
            <p class="lsg4-card-copy">Find the positioning, booking-journey and low-season opportunities worth prioritizing first.</p>
            <ul>
              <li>Website &amp; booking-journey review</li>
              <li>Competitor &amp; positioning analysis</li>
              <li>Five prioritized opportunities</li>
            </ul>
            <div class="lsg4-card-footer">
              <span>PDF strategy · 5 business days*</span>
              <a href="{{ audit.url }}" class="lsg4-btn lsg4-btn-outline">View Audit</a>
            </div>
          </div>
        </article>

        <article class="lsg4-card lsg4-card-featured lsg4-card-sprint">
          <div class="lsg4-recommended">RECOMMENDED</div>
          <div class="lsg4-card-visual">
            {% if sprint.featured_image %}
              <img src="{{ sprint.featured_image | image_url: width: 1200 }}" alt="Booking Sprint" loading="lazy" width="1200" height="900">
            {% endif %}
            <span class="lsg4-visual-tag">BUILD + ACTIVATE</span>
          </div>
          <div class="lsg4-card-body">
            <div class="lsg4-card-top">
              <h3>Booking Sprint</h3>
              <p class="lsg4-price">{{ sprint.price | money }}</p>
            </div>
            <p class="lsg4-card-copy">Build a tailored seasonal offer, a clear 30-day action plan and ready-to-use activation ideas.</p>
            <ul>
              <li>Personalized seasonal offer</li>
              <li>30-day action plan &amp; content concepts</li>
              <li>45-min strategy call + 14-day follow-up</li>
            </ul>
            <div class="lsg4-card-footer">
              <span>Strategy + call · 5 business days*</span>
              <a href="{{ sprint.url }}" class="lsg4-btn lsg4-btn-primary">Choose Sprint</a>
            </div>
          </div>
        </article>

        <article class="lsg4-card lsg4-card-partner">
          <div class="lsg4-card-visual">
            {% if partner.featured_image %}
              <img src="{{ partner.featured_image | image_url: width: 1200 }}" alt="Growth Partner" loading="lazy" width="1200" height="900">
            {% endif %}
            <span class="lsg4-visual-tag">IMPLEMENT</span>
          </div>
          <div class="lsg4-card-body">
            <div class="lsg4-card-top">
              <h3>Growth Partner</h3>
              <p class="lsg4-price">{{ partner.price | money }}</p>
            </div>
            <p class="lsg4-card-copy">Higher-touch strategic support for properties that want help moving from plan to execution.</p>
            <ul>
              <li>Advanced strategy &amp; roadmap</li>
              <li>Two strategy sessions + reviews</li>
              <li>30 days of implementation support</li>
            </ul>
            <div class="lsg4-card-footer">
              <span>Done-with-you · Initial plan 7 days*</span>
              <a href="{{ partner.url }}" class="lsg4-btn lsg4-btn-outline">View Partner</a>
            </div>
          </div>
        </article>
      </div>
      <p class="lsg4-delivery-note">*Delivery timing begins after all required property information is received.</p>
    </div>
  </div>

  <div class="lsg4-section lsg4-soft">
    <div class="lsg4-wrap lsg4-split">
      <div>
        <p class="lsg4-kicker">THE LOW-SEASON GAP</p>
        <h2>Lowering the rate is not the same as creating demand.</h2>
      </div>
      <div class="lsg4-principles">
        <article><b>01</b><div><h3>Target</h3><p>Identify guest segments that can realistically travel in your quieter periods.</p></div></article>
        <article><b>02</b><div><h3>Offer</h3><p>Connect your property, destination and dates into a relevant seasonal proposition.</p></div></article>
        <article><b>03</b><div><h3>Activate</h3><p>Turn content and messaging into a clear direct-booking action.</p></div></article>
      </div>
    </div>
  </div>

  <div class="lsg4-section lsg4-dark" id="process">
    <div class="lsg4-wrap">
      <div class="lsg4-head lsg4-head-light">
        <p class="lsg4-kicker">HOW IT WORKS</p>
        <h2>Four steps from purchase to action.</h2>
      </div>
      <div class="lsg4-process">
        <article><b>01</b><h3>Choose</h3><p>Select the package that matches your current priority.</p></article>
        <article><b>02</b><h3>Share</h3><p>Send your website, OTA listings, low-season dates and core challenge.</p></article>
        <article><b>03</b><h3>Review</h3><p>Your property, positioning, competitors and booking journey are analysed.</p></article>
        <article><b>04</b><h3>Activate</h3><p>Receive the priorities, offer and support included in your package.</p></article>
      </div>
      <a href="/pages/how-it-works" class="lsg4-text-link">Read the full process →</a>
    </div>
  </div>

  <div class="lsg4-section" id="faq">
    <div class="lsg4-wrap lsg4-faq-grid">
      <div>
        <p class="lsg4-kicker">FAQ</p>
        <h2>Know what you are buying before checkout.</h2>
        <p class="lsg4-faq-intro">Clear scope, delivery and limitations. No hidden subscription and no guaranteed revenue claims.</p>
      </div>
      <div class="lsg4-faq-list">
        <details><summary>Who is this for?</summary><p>Independent B&amp;Bs, guest houses, boutique stays and similar hospitality properties that want a more structured approach to low-season demand.</p></details>
        <details><summary>What happens after I purchase?</summary><p>You share the property information required for the selected package. Delivery timing starts once all required information has been received.</p></details>
        <details><summary>Is this ongoing revenue management?</summary><p>No. These are defined consulting packages. Paid media spend, daily campaign management and ongoing revenue management are not included unless separately agreed.</p></details>
        <details><summary>Do you guarantee bookings?</summary><p>No. The service provides analysis, strategy and activation materials, but specific booking, occupancy or revenue results cannot be guaranteed.</p></details>
      </div>
    </div>
  </div>

  <div class="lsg4-final">
    <div class="lsg4-wrap lsg4-final-inner">
      <p class="lsg4-kicker">START WITH CLARITY</p>
      <h2>Make your quieter months easier to understand, package and sell.</h2>
      <p>Choose the level of support that fits your property today.</p>
      <a href="#packages" class="lsg4-btn lsg4-btn-primary">Compare packages</a>
      <small>Secure checkout powered by Shopify · Personalized consulting · Specific commercial results cannot be guaranteed</small>
    </div>
  </div>

  <a class="lsg4-mobile-cta" href="#packages" aria-label="Compare Low Season Growth packages">Compare packages <span>→</span></a>
</section>

{% stylesheet %}
.lsg4{--paper:#fff;--cream:#f4f1ea;--soft:#faf8f3;--forest:#173f35;--forest2:#215246;--ink:#202925;--muted:#69726e;--accent:#9a654e;--line:#dfd9cf;color:var(--ink);background:var(--paper);font-family:var(--font-body--family);scroll-behavior:smooth}.lsg4 *{box-sizing:border-box}.lsg4-wrap{width:min(1180px,calc(100% - 40px));margin:0 auto}.lsg4 h1,.lsg4 h2,.lsg4 h3{font-family:Georgia,var(--font-heading--family),serif}.lsg4-kicker{margin:0 0 14px;color:var(--accent);font-size:.7rem;font-weight:850;letter-spacing:.15em;text-transform:uppercase}.lsg4-hero{padding:88px 0 76px;background:linear-gradient(180deg,#f7f4ed 0%,#f1ebe1 100%)}.lsg4-hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center}.lsg4-hero h1{max-width:740px;margin:0;color:var(--forest);font-size:clamp(3.2rem,5.8vw,5.65rem);font-weight:400;line-height:.99;letter-spacing:-.05em}.lsg4-lead{max-width:650px;margin:25px 0 0;color:#59645f;font-size:clamp(1.04rem,1.45vw,1.18rem);line-height:1.68}.lsg4-actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:31px}.lsg4-btn{display:inline-flex;min-height:49px;align-items:center;justify-content:center;padding:12px 21px;border:1px solid var(--forest);border-radius:7px;text-decoration:none;font-size:.91rem;font-weight:780;transition:background .2s ease,border-color .2s ease,transform .2s ease}.lsg4-btn:hover{transform:translateY(-1px)}.lsg4-btn-primary{color:#fff;background:var(--forest)}.lsg4-btn-primary:hover{background:var(--forest2)}.lsg4-btn-secondary,.lsg4-btn-outline{color:var(--forest);background:transparent}.lsg4-btn-secondary:hover,.lsg4-btn-outline:hover{background:#fff}.lsg4-trust{display:flex;gap:8px 18px;flex-wrap:wrap;margin-top:18px;color:#6a746f;font-size:.82rem}.lsg4-trust span{position:relative;padding-left:13px}.lsg4-trust span:before{content:'•';position:absolute;left:0;color:var(--accent)}.lsg4-hero-media{margin:0}.lsg4-hero-frame{overflow:hidden;border:1px solid rgba(23,63,53,.08);border-radius:18px;background:#ece6dc;box-shadow:0 22px 55px rgba(23,63,53,.11)}.lsg4-hero-frame img{display:block;width:100%;height:auto}.lsg4-hero-media figcaption{margin-top:10px;color:#777f7b;font-size:.76rem;text-align:right}.lsg4-proof{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff}.lsg4-proof-grid{display:grid;grid-template-columns:repeat(3,1fr)}.lsg4-proof span{padding:19px 22px;text-align:center;border-right:1px solid var(--line);font-size:.84rem;font-weight:690}.lsg4-proof span:last-child{border:0}.lsg4-section{padding:94px 0}.lsg4-soft{background:var(--soft)}.lsg4-head{max-width:760px;margin-bottom:42px}.lsg4-head h2,.lsg4-split h2,.lsg4-faq-grid h2,.lsg4-final h2{margin:0;color:var(--forest);font-size:clamp(2.35rem,4.1vw,4rem);font-weight:400;line-height:1.06;letter-spacing:-.04em}.lsg4-head>p:last-child{max-width:690px;margin:18px 0 0;color:var(--muted);font-size:1.03rem;line-height:1.68}.lsg4-packages{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:stretch}.lsg4-card{position:relative;overflow:hidden;display:flex;flex-direction:column;border:1px solid var(--line);border-radius:16px;background:#fff;box-shadow:0 7px 24px rgba(23,63,53,.045)}.lsg4-card-featured{border:1.5px solid var(--forest);box-shadow:0 18px 44px rgba(23,63,53,.1)}.lsg4-recommended{position:absolute;z-index:3;top:15px;right:15px;padding:7px 10px;border-radius:999px;color:#fff;background:var(--forest);font-size:.61rem;font-weight:850;letter-spacing:.11em}.lsg4-card-visual{position:relative;overflow:hidden;aspect-ratio:16/10;margin:14px 14px 0;border-radius:11px;background:#eee9df}.lsg4-card-visual:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(20,42,35,.16) 100%);pointer-events:none}.lsg4-card-visual img{display:block;width:100%;height:100%;object-fit:cover;filter:saturate(.78) contrast(.96) brightness(1.03);transform:scale(1.18);transition:transform .45s ease,filter .3s ease}.lsg4-card-audit .lsg4-card-visual img{object-position:center 68%}.lsg4-card-sprint .lsg4-card-visual img{object-position:center 66%}.lsg4-card-partner .lsg4-card-visual img{object-position:center 70%}.lsg4-card:hover .lsg4-card-visual img{transform:scale(1.22);filter:saturate(.86) contrast(.98) brightness(1.02)}.lsg4-visual-tag{position:absolute;z-index:2;left:12px;bottom:12px;padding:6px 8px;border-radius:6px;color:#fff;background:rgba(23,63,53,.9);font-size:.61rem;font-weight:850;letter-spacing:.12em}.lsg4-card-body{display:flex;flex:1;flex-direction:column;padding:24px 25px 25px}.lsg4-card-top{display:flex;gap:14px;align-items:flex-start;justify-content:space-between}.lsg4-card h3{margin:0;color:var(--forest);font-size:1.6rem;font-weight:400;line-height:1.12}.lsg4-price{margin:0;color:var(--forest);font-size:1.2rem;font-weight:800;white-space:nowrap}.lsg4-card-copy{margin:18px 0 0;color:var(--muted);line-height:1.58}.lsg4-card ul{display:grid;gap:10px;margin:22px 0;padding:19px 0 0;border-top:1px solid var(--line);list-style:none}.lsg4-card li{position:relative;padding-left:20px;color:#59645f;font-size:.92rem;line-height:1.42}.lsg4-card li:before{content:'✓';position:absolute;left:0;color:var(--accent);font-weight:900}.lsg4-card-footer{display:grid;gap:14px;margin-top:auto}.lsg4-card-footer>span{color:#7a827e;font-size:.75rem}.lsg4-card-footer .lsg4-btn{width:100%}.lsg4-delivery-note{margin:17px 0 0;color:#7c847f;font-size:.74rem}.lsg4-split{display:grid;grid-template-columns:.9fr 1.1fr;gap:78px;align-items:start}.lsg4-principles{display:grid}.lsg4-principles article{display:grid;grid-template-columns:42px 1fr;gap:16px;padding:21px 0;border-top:1px solid var(--line)}.lsg4-principles article:first-child{border-top:0;padding-top:0}.lsg4-principles b{color:var(--accent);font-size:.72rem}.lsg4-principles h3{margin:0 0 5px;color:var(--forest);font-size:1.25rem;font-weight:400}.lsg4-principles p{margin:0;color:var(--muted);line-height:1.58}.lsg4-dark{color:#fff;background:var(--forest)}.lsg4-head-light h2{color:#fff}.lsg4-head-light .lsg4-kicker{color:#dfad94}.lsg4-process{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.lsg4-process article{padding:24px;border:1px solid rgba(255,255,255,.15);border-radius:10px;background:rgba(255,255,255,.035)}.lsg4-process b{display:grid;width:31px;height:31px;place-items:center;border-radius:50%;color:var(--forest);background:#fff;font-size:.67rem}.lsg4-process h3{margin:25px 0 8px;color:#fff;font-size:1.2rem;font-weight:400}.lsg4-process p{margin:0;color:#d8e1dd;font-size:.9rem;line-height:1.57}.lsg4-text-link{display:inline-flex;margin-top:26px;color:#fff;text-decoration:none;font-weight:760}.lsg4-faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:start}.lsg4-faq-intro{max-width:480px;margin:18px 0 0;color:var(--muted);line-height:1.65}.lsg4-faq-list details{border-bottom:1px solid var(--line);padding:20px 0}.lsg4-faq-list summary{cursor:pointer;color:var(--forest);font-weight:760;line-height:1.45}.lsg4-faq-list details p{margin:12px 0 0;color:var(--muted);line-height:1.65}.lsg4-final{padding:92px 0;background:var(--cream)}.lsg4-final-inner{max-width:850px;text-align:center}.lsg4-final h2{margin-inline:auto}.lsg4-final-inner>p:not(.lsg4-kicker){max-width:620px;margin:18px auto;color:var(--muted);font-size:1.04rem;line-height:1.65}.lsg4-final .lsg4-btn{margin-top:7px}.lsg4-final small{display:block;margin-top:18px;color:#777f7b;font-size:.76rem}.lsg4-mobile-cta{display:none}.lsg4 a:focus-visible,.lsg4 summary:focus-visible{outline:3px solid var(--forest);outline-offset:4px}
@media(max-width:960px){.lsg4-hero-grid,.lsg4-split,.lsg4-faq-grid{grid-template-columns:1fr}.lsg4-hero-grid{gap:46px}.lsg4-hero-media{max-width:720px}.lsg4-packages{grid-template-columns:1fr}.lsg4-card-featured{order:-1}.lsg4-process{grid-template-columns:1fr 1fr}.lsg4-split,.lsg4-faq-grid{gap:38px}.lsg4-card-visual{aspect-ratio:16/8.8}}
@media(max-width:640px){.lsg4-wrap{width:min(100% - 28px,1180px)}.lsg4-hero{padding:58px 0 52px}.lsg4-hero h1{font-size:2.92rem}.lsg4-actions{display:grid}.lsg4-btn{width:100%}.lsg4-hero-media figcaption{display:none}.lsg4-proof-grid{grid-template-columns:1fr}.lsg4-proof span{border-right:0;border-bottom:1px solid var(--line)}.lsg4-proof span:last-child{border-bottom:0}.lsg4-section{padding:66px 0}.lsg4-packages{gap:16px}.lsg4-card-visual{margin:10px 10px 0;aspect-ratio:16/9}.lsg4-card-body{padding:21px}.lsg4-card-top{align-items:flex-end}.lsg4-card h3{font-size:1.48rem}.lsg4-process{grid-template-columns:1fr}.lsg4-final{padding:68px 0 92px}.lsg4-mobile-cta{position:fixed;z-index:30;right:14px;bottom:14px;left:14px;display:flex;min-height:50px;align-items:center;justify-content:space-between;padding:12px 18px;border-radius:10px;color:#fff;background:var(--forest);box-shadow:0 12px 30px rgba(23,63,53,.22);text-decoration:none;font-weight:800}.lsg4-mobile-cta span{font-size:1.15rem}}
@media(prefers-reduced-motion:reduce){.lsg4 *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
{% endstylesheet %}

{% schema %}
{
  "name": "Low Season Growth v4",
  "settings": [],
  "presets": [{"name":"Low Season Growth v4"}]
}
{% endschema %}
