{% assign audit = all_products['b-b-low-season-opportunity-audit'] %}
{% assign sprint = all_products['b-b-low-season-booking-sprint'] %}
{% assign partner = all_products['b-b-low-season-growth-partner'] %}

<section class="lsg5" aria-label="Low Season Growth">
  <div class="lsg5-hero">
    <div class="lsg5-hero-copy">
      <div class="lsg5-copy-inner">
        <p class="lsg5-kicker">LOW-SEASON STRATEGY FOR INDEPENDENT PROPERTIES</p>
        <h1>Turn quiet months into a reason to book.</h1>
        <p class="lsg5-lead">Practical consulting for independent B&amp;Bs and small hospitality properties that want clearer positioning, stronger seasonal offers and more direct-booking opportunities.</p>
        <div class="lsg5-actions">
          <a href="#packages" class="lsg5-btn lsg5-btn-primary">Explore packages</a>
          <a href="#process" class="lsg5-btn lsg5-btn-secondary">How it works</a>
        </div>
        <div class="lsg5-trust">
          <span>One-time payment</span><span>Property-specific</span><span>English or Italian</span>
        </div>
      </div>
    </div>
    <div class="lsg5-hero-image" role="img" aria-label="Independent hospitality property overlooking the sea in a quiet season"></div>
  </div>

  <div class="lsg5-proof">
    <div class="lsg5-wrap lsg5-proof-grid">
      <div><b>01</b><span>More direct-booking opportunities</span></div>
      <div><b>02</b><span>A stronger low-season offer</span></div>
      <div><b>03</b><span>A clearer commercial direction</span></div>
      <div><b>04</b><span>Built for independent hospitality</span></div>
    </div>
  </div>

  <div class="lsg5-section" id="packages">
    <div class="lsg5-wrap">
      <header class="lsg5-section-head">
        <p class="lsg5-kicker">OUR PACKAGES</p>
        <h2>Choose the support your property needs.</h2>
        <p>Three focused, one-time services. Clear scope, clear pricing and work built around your property.</p>
      </header>

      <div class="lsg5-cards">
        <article class="lsg5-card">
          <a href="{{ audit.url }}" class="lsg5-card-image" aria-label="View Opportunity Audit">
            {% if audit.featured_image %}<img src="{{ audit.featured_image | image_url: width: 1200 }}" alt="Opportunity Audit hospitality planning" width="1200" height="405" loading="lazy">{% endif %}
          </a>
          <div class="lsg5-card-body">
            <p class="lsg5-label">DIAGNOSE</p>
            <h3>Opportunity Audit</h3>
            <p class="lsg5-card-copy">A focused diagnostic to identify low-season positioning gaps and the opportunities worth prioritizing first.</p>
            <ul><li>Website &amp; booking-journey review</li><li>Low-season positioning analysis</li><li>Five actionable priorities</li></ul>
            <div class="lsg5-card-bottom"><strong>{{ audit.price | money }}</strong><a href="{{ audit.url }}" class="lsg5-btn lsg5-btn-outline">Get Opportunity Audit</a></div>
          </div>
        </article>

        <article class="lsg5-card lsg5-card-featured">
          <div class="lsg5-popular">MOST POPULAR</div>
          <a href="{{ sprint.url }}" class="lsg5-card-image" aria-label="View Booking Sprint">
            {% if sprint.featured_image %}<img src="{{ sprint.featured_image | image_url: width: 1200 }}" alt="Booking Sprint independent B&B strategy" width="1200" height="403" loading="lazy">{% endif %}
          </a>
          <div class="lsg5-card-body">
            <p class="lsg5-label">BUILD + ACTIVATE</p>
            <h3>Booking Sprint</h3>
            <p class="lsg5-card-copy">A practical offer and messaging sprint to help your property turn quiet dates into a clearer booking proposition.</p>
            <ul><li>Tailored seasonal offer strategy</li><li>30-day action plan &amp; content guidance</li><li>Strategy call + 14-day follow-up</li></ul>
            <div class="lsg5-card-bottom"><strong>{{ sprint.price | money }}</strong><a href="{{ sprint.url }}" class="lsg5-btn lsg5-btn-primary">Get Booking Sprint</a></div>
          </div>
        </article>

        <article class="lsg5-card">
          <a href="{{ partner.url }}" class="lsg5-card-image" aria-label="View Growth Partner">
            {% if partner.featured_image %}<img src="{{ partner.featured_image | image_url: width: 1200 }}" alt="Growth Partner strategic hospitality support" width="1200" height="405" loading="lazy">{% endif %}
          </a>
          <div class="lsg5-card-body">
            <p class="lsg5-label">IMPLEMENT</p>
            <h3>Growth Partner</h3>
            <p class="lsg5-card-copy">Deeper strategic support for properties that want a clearer commercial direction and help moving from plan to execution.</p>
            <ul><li>Advanced analysis &amp; roadmap</li><li>Offer and distribution optimisation</li><li>30 days of strategic support</li></ul>
            <div class="lsg5-card-bottom"><strong>{{ partner.price | money }}</strong><a href="{{ partner.url }}" class="lsg5-btn lsg5-btn-outline">Get Growth Partner</a></div>
          </div>
        </article>
      </div>
      <p class="lsg5-note">Delivery timing begins after all required property information is received. Specific booking or revenue results cannot be guaranteed.</p>
    </div>
  </div>

  <div class="lsg5-section lsg5-soft">
    <div class="lsg5-wrap lsg5-split">
      <div>
        <p class="lsg5-kicker">THE LOW-SEASON GAP</p>
        <h2>Lowering the rate is not the same as creating demand.</h2>
      </div>
      <div class="lsg5-principles">
        <article><b>01</b><div><h3>Target</h3><p>Identify guest segments that can realistically travel in your quieter periods.</p></div></article>
        <article><b>02</b><div><h3>Offer</h3><p>Connect your property, destination and dates into a relevant seasonal proposition.</p></div></article>
        <article><b>03</b><div><h3>Activate</h3><p>Turn messaging and content into a clear next step toward direct booking.</p></div></article>
      </div>
    </div>
  </div>

  <div class="lsg5-section lsg5-dark" id="process">
    <div class="lsg5-wrap">
      <header class="lsg5-section-head lsg5-head-light"><p class="lsg5-kicker">HOW IT WORKS</p><h2>Four steps from purchase to action.</h2></header>
      <div class="lsg5-process">
        <article><b>01</b><h3>Choose</h3><p>Select the package that matches your current priority.</p></article>
        <article><b>02</b><h3>Share</h3><p>Send your website, OTA listings, low-season dates and core challenge.</p></article>
        <article><b>03</b><h3>Review</h3><p>Your property, positioning, competitors and booking journey are analysed.</p></article>
        <article><b>04</b><h3>Activate</h3><p>Receive the priorities, offer and support included in your package.</p></article>
      </div>
      <a href="/pages/how-it-works" class="lsg5-link">Read the full process →</a>
    </div>
  </div>

  <div class="lsg5-section" id="faq">
    <div class="lsg5-wrap lsg5-faq">
      <div><p class="lsg5-kicker">FAQ</p><h2>Before you buy.</h2><p>Clear scope, delivery and limitations. No hidden subscription.</p></div>
      <div class="lsg5-faq-list">
        <details><summary>Who is this service for?</summary><p>Independent B&amp;Bs, guest houses, boutique stays and similar hospitality properties that want a more structured approach to low-season demand.</p></details>
        <details><summary>What happens after purchase?</summary><p>You share the information required for your selected package. Delivery starts once the required property information has been received.</p></details>
        <details><summary>Is this ongoing revenue management?</summary><p>No. These are defined consulting packages. Paid media spend, daily campaign management and ongoing revenue management are not included unless separately agreed.</p></details>
        <details><summary>Do you guarantee bookings?</summary><p>No. The service provides analysis, strategy and activation materials, but specific booking, occupancy or revenue results cannot be guaranteed.</p></details>
      </div>
    </div>
  </div>

  <div class="lsg5-final">
    <div class="lsg5-wrap lsg5-final-inner"><p class="lsg5-kicker">START WITH CLARITY</p><h2>Give your property a stronger reason to be booked this low season.</h2><p>Choose the level of support that fits your property today.</p><a href="#packages" class="lsg5-btn lsg5-btn-primary">Explore packages</a><small>Secure checkout powered by Shopify · Personalized consulting</small></div>
  </div>

  <a class="lsg5-mobile-cta" href="#packages">Explore packages <span>→</span></a>
</section>

{% stylesheet %}
.lsg5{--paper:#fff;--cream:#f6f2ea;--soft:#fbf9f5;--forest:#0d3f34;--forest2:#175348;--ink:#202824;--muted:#626b67;--line:#ded8cd;color:var(--ink);background:var(--paper);font-family:var(--font-body--family);scroll-behavior:smooth}.lsg5 *{box-sizing:border-box}.lsg5-wrap{width:min(1240px,calc(100% - 48px));margin:0 auto}.lsg5 h1,.lsg5 h2,.lsg5 h3{font-family:Georgia,var(--font-heading--family),serif;font-weight:400}.lsg5-kicker{margin:0 0 16px;color:var(--forest);font-size:.69rem;font-weight:800;letter-spacing:.19em;text-transform:uppercase}.lsg5-hero{display:grid;grid-template-columns:49% 51%;min-height:590px;background:var(--cream)}.lsg5-hero-copy{display:flex;align-items:center}.lsg5-copy-inner{width:min(640px,calc(100% - 48px));margin-left:max(24px,calc((100vw - 1240px)/2))}.lsg5-hero h1{max-width:650px;margin:0;color:var(--forest);font-size:clamp(3.35rem,5.6vw,5.8rem);line-height:.98;letter-spacing:-.052em}.lsg5-lead{max-width:600px;margin:24px 0 0;color:#515b56;font-size:clamp(1.03rem,1.35vw,1.18rem);line-height:1.65}.lsg5-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:31px}.lsg5-btn{display:inline-flex;min-height:48px;align-items:center;justify-content:center;padding:11px 22px;border:1px solid var(--forest);border-radius:4px;text-decoration:none;font-size:.9rem;font-weight:760;transition:.2s ease}.lsg5-btn:hover{transform:translateY(-1px)}.lsg5-btn-primary{color:#fff;background:var(--forest)}.lsg5-btn-primary:hover{background:var(--forest2)}.lsg5-btn-secondary,.lsg5-btn-outline{color:var(--forest);background:transparent}.lsg5-btn-secondary:hover,.lsg5-btn-outline:hover{background:#fff}.lsg5-trust{display:flex;gap:8px 18px;flex-wrap:wrap;margin-top:18px;color:#6c746f;font-size:.79rem}.lsg5-trust span:before{content:'✓';margin-right:7px;color:var(--forest)}.lsg5-hero-image{min-height:590px;background:url('https://cdn.shopify.com/s/files/1/1059/8488/5078/files/low-season-growth-hero-clean.png?v=1788549393') center center/cover no-repeat}.lsg5-proof{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff}.lsg5-proof-grid{display:grid;grid-template-columns:repeat(4,1fr)}.lsg5-proof-grid>div{display:flex;gap:12px;align-items:center;padding:22px 18px;border-right:1px solid var(--line)}.lsg5-proof-grid>div:last-child{border-right:0}.lsg5-proof b{color:var(--forest);font-size:.72rem}.lsg5-proof span{font-size:.82rem;font-weight:700}.lsg5-section{padding:88px 0}.lsg5-section-head{max-width:780px;margin:0 auto 40px;text-align:center}.lsg5-section-head h2,.lsg5-split h2,.lsg5-faq h2,.lsg5-final h2{margin:0;color:var(--forest);font-size:clamp(2.4rem,4vw,4rem);line-height:1.05;letter-spacing:-.038em}.lsg5-section-head>p:last-child{max-width:660px;margin:16px auto 0;color:var(--muted);font-size:1rem;line-height:1.62}.lsg5-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;align-items:stretch}.lsg5-card{position:relative;display:flex;overflow:hidden;flex-direction:column;border:1px solid var(--line);border-radius:7px;background:#fff;box-shadow:0 8px 24px rgba(20,45,37,.035)}.lsg5-card-featured{border-color:#6ea393;box-shadow:0 16px 42px rgba(13,63,52,.10)}.lsg5-popular{position:absolute;z-index:3;top:0;left:50%;padding:8px 15px;transform:translate(-50%,-1px);border-radius:0 0 5px 5px;color:#fff;background:#2e7867;font-size:.63rem;font-weight:800;letter-spacing:.12em}.lsg5-card-image{display:block;overflow:hidden;aspect-ratio:16/6.1;background:#eee9df}.lsg5-card-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .35s ease}.lsg5-card:hover .lsg5-card-image img{transform:scale(1.025)}.lsg5-card-body{display:flex;flex:1;flex-direction:column;padding:24px}.lsg5-label{margin:0 0 9px;color:#78827d;font-size:.65rem;font-weight:800;letter-spacing:.13em}.lsg5-card h3{margin:0;color:var(--forest);font-size:1.55rem;line-height:1.12}.lsg5-card-copy{margin:14px 0 0;color:var(--muted);font-size:.94rem;line-height:1.55}.lsg5-card ul{display:grid;gap:9px;margin:19px 0 25px;padding:18px 0 0;border-top:1px solid var(--line);list-style:none}.lsg5-card li{position:relative;padding-left:20px;color:#505b56;font-size:.87rem;line-height:1.42}.lsg5-card li:before{content:'✓';position:absolute;left:0;color:var(--forest);font-weight:900}.lsg5-card-bottom{display:grid;gap:15px;margin-top:auto}.lsg5-card-bottom strong{color:#111;font-family:Georgia,serif;font-size:1.65rem;font-weight:400}.lsg5-card-bottom .lsg5-btn{width:100%}.lsg5-note{margin:17px 0 0;text-align:center;color:#818782;font-size:.72rem}.lsg5-soft{background:var(--soft)}.lsg5-split{display:grid;grid-template-columns:.9fr 1.1fr;gap:90px;align-items:start}.lsg5-principles article{display:grid;grid-template-columns:44px 1fr;gap:16px;padding:22px 0;border-top:1px solid var(--line)}.lsg5-principles article:first-child{padding-top:0;border-top:0}.lsg5-principles b{color:#846652;font-size:.7rem}.lsg5-principles h3{margin:0 0 5px;color:var(--forest);font-size:1.28rem}.lsg5-principles p{margin:0;color:var(--muted);line-height:1.58}.lsg5-dark{color:#fff;background:var(--forest)}.lsg5-head-light h2{color:#fff}.lsg5-head-light .lsg5-kicker{color:#d6bca8}.lsg5-process{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.lsg5-process article{padding:24px;border:1px solid rgba(255,255,255,.15);border-radius:6px;background:rgba(255,255,255,.035)}.lsg5-process b{color:#d7bba6;font-size:.68rem}.lsg5-process h3{margin:24px 0 7px;color:#fff;font-size:1.2rem}.lsg5-process p{margin:0;color:#d7e0dc;font-size:.88rem;line-height:1.56}.lsg5-link{display:inline-flex;margin-top:27px;color:#fff;text-decoration:none;font-weight:760}.lsg5-faq{display:grid;grid-template-columns:.75fr 1.25fr;gap:80px;align-items:start}.lsg5-faq>div:first-child>p:last-child{color:var(--muted);line-height:1.6}.lsg5-faq-list details{padding:20px 0;border-bottom:1px solid var(--line)}.lsg5-faq-list summary{cursor:pointer;color:var(--forest);font-weight:760}.lsg5-faq-list details p{margin:12px 0 0;color:var(--muted);line-height:1.62}.lsg5-final{padding:86px 0;background:var(--cream)}.lsg5-final-inner{max-width:850px;text-align:center}.lsg5-final-inner>p:not(.lsg5-kicker){max-width:620px;margin:17px auto;color:var(--muted);line-height:1.6}.lsg5-final .lsg5-btn{margin-top:5px}.lsg5-final small{display:block;margin-top:18px;color:#7b827e}.lsg5-mobile-cta{display:none}.lsg5 a:focus-visible,.lsg5 summary:focus-visible{outline:3px solid var(--forest);outline-offset:4px}
@media(max-width:980px){.lsg5-hero{grid-template-columns:1fr}.lsg5-hero-copy{padding:64px 0 54px}.lsg5-copy-inner{width:min(100% - 40px,760px);margin:0 auto}.lsg5-hero-image{min-height:450px}.lsg5-proof-grid{grid-template-columns:1fr 1fr}.lsg5-proof-grid>div:nth-child(2){border-right:0}.lsg5-proof-grid>div:nth-child(-n+2){border-bottom:1px solid var(--line)}.lsg5-cards{grid-template-columns:1fr}.lsg5-card-featured{order:-1}.lsg5-card-image{aspect-ratio:16/5}.lsg5-split,.lsg5-faq{grid-template-columns:1fr;gap:42px}.lsg5-process{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.lsg5-wrap{width:min(100% - 28px,1240px)}.lsg5-hero-copy{padding:52px 0 42px}.lsg5-copy-inner{width:calc(100% - 28px)}.lsg5-hero h1{font-size:2.95rem}.lsg5-actions{display:grid}.lsg5-btn{width:100%}.lsg5-hero-image{min-height:330px;background-position:58% center}.lsg5-proof-grid{grid-template-columns:1fr}.lsg5-proof-grid>div{border-right:0;border-bottom:1px solid var(--line)!important;padding:16px 8px}.lsg5-proof-grid>div:last-child{border-bottom:0!important}.lsg5-section{padding:64px 0}.lsg5-section-head{text-align:left;margin-bottom:28px}.lsg5-section-head>p:last-child{margin-left:0}.lsg5-cards{gap:17px}.lsg5-card-image{aspect-ratio:16/7}.lsg5-card-body{padding:21px}.lsg5-process{grid-template-columns:1fr}.lsg5-final{padding:66px 0 88px}.lsg5-mobile-cta{position:fixed;z-index:30;right:14px;bottom:14px;left:14px;display:flex;min-height:50px;align-items:center;justify-content:space-between;padding:12px 18px;border-radius:6px;color:#fff;background:var(--forest);box-shadow:0 12px 30px rgba(13,63,52,.24);text-decoration:none;font-weight:800}}
@media(prefers-reduced-motion:reduce){.lsg5 *{transition:none!important;scroll-behavior:auto!important}}
{% endstylesheet %}

{% schema %}
{
  "name": "Low Season Growth v5",
  "settings": [],
  "presets": [{"name":"Low Season Growth v5"}]
}
{% endschema %}
